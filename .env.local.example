# Supabase (galabau)
NEXT_PUBLIC_SUPABASE_URL=https://qivynlutooucifamhaxt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Pflicht für Registrierung, Passwort-Reset, Superadmin — auf Hostinger manuell setzen
# (Hostinger liefert nur SUPABASE_URL + SUPABASE_ANON_KEY automatisch).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Plattform
NEXT_PUBLIC_PLATFORM_NAME=BauDiggie
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Produktion (Hostinger): NEXT_PUBLIC_ROOT_DOMAIN=baudiggi.de

# Einladungs-Tokens (Production: eigenen Wert setzen; Fallback auf PASSWORD_RESET_PEPPER)
INVITE_TOKEN_PEPPER=
PASSWORD_RESET_PEPPER=

# E-Mail (SMTP) — Pflicht für Passwort-Reset, Einladungen, Rapport-Versand
# Hostinger (Postfach z. B. noreply@baudiggi.de in hPanel anlegen):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@baudiggi.de
# SMTP_PASSWORD=<Postfach-Passwort>
# SMTP_FROM=noreply@baudiggi.de
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# KI (Lieferschein-Scan via Mistral Document AI)
MISTRAL_API_KEY=

# KI (Diktierfunktion Tagesrapport via OpenAI Whisper + Strukturierung)
OPENAI_API_KEY=
