# Supabase (galabau)
NEXT_PUBLIC_SUPABASE_URL=https://qivynlutooucifamhaxt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Pflicht für Registrierung, Passwort-Reset, Superadmin — auf Hostinger manuell setzen
# (Hostinger liefert nur SUPABASE_URL + SUPABASE_ANON_KEY automatisch).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Plattform
NEXT_PUBLIC_PLATFORM_NAME=BauDiggi
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Produktion (Hostinger): NEXT_PUBLIC_ROOT_DOMAIN=baudiggi.de

# Einladungs-Tokens (Production: eigenen Wert setzen; Fallback auf PASSWORD_RESET_PEPPER)
INVITE_TOKEN_PEPPER=
PASSWORD_RESET_PEPPER=

# E-Mail (SMTP) — App-Transaktionsmails (Passwort-Reset, Mitarbeiter-Einladungen)
# Fachliche Mails (Rapporte, Bestellungen, Einsatzplan) pro Mandant unter Einstellungen → E-Mail-Versand.
# Hostinger (Postfach z. B. noreply@baudiggi.de in hPanel anlegen):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# (Port 465 erfordert oft explizit TLS — ohne SMTP_SECURE=true kann der Versand fehlschlagen.)
# SMTP_USER=noreply@baudiggi.de
# SMTP_PASSWORD=<Postfach-Passwort>
# SMTP_FROM=BauDiggi <noreply@baudiggi.de>
# SMTP_TO=optional-fallback@baudiggi.de
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Verschlüsselung der Mandanten-SMTP-Passwörter in der DB (mind. 16 Zeichen oder 64 Hex-Zeichen)
SMTP_ENCRYPTION_KEY=

# KI (Lieferschein-Scan via Mistral Document AI)
MISTRAL_API_KEY=

# KI (Diktierfunktion Tagesrapport via OpenAI Whisper + Strukturierung)
OPENAI_API_KEY=

# Cursor Cloud Agent — Bug-Autofix (siehe docs/cursor-bug-autofix-automation.md)
# Lokal leer lassen, damit keine Agent-Läufe aus der Entwicklung starten.
CURSOR_AUTOMATION_WEBHOOK_URL=
CURSOR_AUTOMATION_WEBHOOK_TOKEN=
# Optional: Mindestlänge Beschreibung (Default 40), max. Starts pro UTC-Tag (Default 5)
# CURSOR_AGENT_MIN_DESCRIPTION_LENGTH=40
# CURSOR_AGENT_DAILY_LIMIT=5
# GitHub → App: PR geöffnet → PR-Link in interner Notiz + Mail
GITHUB_WEBHOOK_SECRET=
